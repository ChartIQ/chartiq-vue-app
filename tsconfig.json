{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"outDir": "./dist",
		"strict": true,
		"jsx": "preserve",
		//Setting "forceConsistentCasingInFileNames": true is a best practice that helps ensure that your 
		// TypeScript project maintains consistent file naming conventions, reducing the bugs and improving code quality.
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"checkJs": false,
		"importHelpers": true,
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"baseUrl": ".",
		"types": ["webpack-env"],
		"paths": {
			"@/*": ["src/*"]
		},
		"lib": ["esnext", "dom", "dom.iterable", "scripthost"],
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/**/*.ts",
		"tests/**/*.tsx"
	],
"exclude": [
	"node_modules",
	"tests/stx/**/*"
]
}
